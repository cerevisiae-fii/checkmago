/* ===== 棋譜 ===== */
const kifText=l=>l.join(' ');
function parseKif(txt){
  let a=txt.trim().split(/\s+/).filter(Boolean);
  if(!a.length)return{err:'棋譜が空です'};
  const ops=[],C={W:1,B:2};
  if(a[0]=='CMG1'){/* 旧形式 */
    a=a.slice(1);if(!a.length)return{err:'棋譜が空です'};
    for(const k of a){let m;
      if(m=/^S([0-8])([0-8])$/.exec(k))ops.push({t:k,k:'s',c:0,x:+m[1],y:+m[2]});
      else if(k=='P')ops.push({t:k,k:'p',c:0});
      else if((m=/^M(\d{1,2})-(\d{1,2})$/.exec(k))&&+m[1]<64&&+m[2]<64)ops.push({t:k,k:'m',c:0,a:+m[1],b:+m[2],pc:''});
      else if(m=/^R([12])$/.exec(k))ops.push({t:k,k:'r',c:+m[1]});
      else return{err:'解釈できない記号: '+k}}
    return{ops};
  }
  const sq=(c,r)=>(8-r)*8+FL.indexOf(c);
  for(const k of a){let m;
    if(m=/^([WB])pass$/.exec(k))ops.push({t:k,k:'p',c:C[m[1]]});
    else if(m=/^([WB])resign$/.exec(k))ops.push({t:k,k:'r',c:C[m[1]]});
    else if(m=/^([WB])?([1-9])([1-9])$/.exec(k))ops.push({t:k,k:'s',c:C[m[1]]||0,x:m[2]-1,y:m[3]-1});
    else if(m=/^([WB])?([a-h])([1-8])[-x]([a-h])([1-8])([KQRBN])?(=Q)?$/.exec(k))ops.push({t:k,k:'m',c:C[m[1]]||0,a:sq(m[2],+m[3]),b:sq(m[4],+m[5]),pc:m[6]||''});
    else return{err:'解釈できない記号: '+k}}
  return{ops};
}
function dsc(o,Sb){
  const w=NM[o.c||Sb.turn];
  if(o.k=='s')return w+' 石 '+(o.x+1)+(o.y+1);
  if(o.k=='p')return w+' 石パス';
  if(o.k=='r')return NM[o.c]+' 投了';
  const q=Sb.pc[o.a],x=Sb.pc[o.b];
  return w+' '+GL[q.t]+sqn(o.a)+(x?'x':'-')+sqn(o.b);
}
function build(ops){
  const sv={S,hist,hk,kif,sel,pend,msg};
  try{
    hist=[];hk=[];kif=[];sel=-1;pend=null;msg='';S=newS();norm();
    const snaps=[JSON.stringify(S)],ds=[],hl=[];
    for(let n=0;n<ops.length;n++){
      const o=ops[n],pre=(n+1)+'手目('+o.t+'): ';
      if(S.over)return{err:pre+'終局後に手があります'};
      let d,e='',h={};try{d=dsc(o,S)}catch(_){d=o.t}
      if(o.k!='r'&&o.c&&o.c!=S.turn)e='手番が違います(W/B の指定と合いません)';
      else if(o.k=='s'){if(S.phase!='stone')e='今は石を置く局面ではありません';else{e=place(o.x,o.y);h.s=[o.x,o.y]}}
      else if(o.k=='p'){if(S.phase!='stone')e='今は石を置く局面ではありません';else passStone()}
      else if(o.k=='r'){push();kif.push(CN[o.c]+'resign');S.over={win:3-o.c,why:NM[o.c]+'が投了しました'}}
      else{
        const q=S.pc[o.a];
        if(S.phase!='move')e='今は駒を動かす局面ではありません';
        else if(!q||q.o!=S.turn)e='その駒は動かせません';
        else if(o.pc&&q.t!=o.pc)e='駒の種類が一致しません';
        else if(S.mv?S.mv.i!=o.a:actOf(o.a)==0)e='その駒は動かせません';
        else{const mo=gen(o.a).find(z=>z.to==o.b);if(!mo)e='違法な移動です';else{doMove(o.a,mo);h.m=[o.a,o.b]}}
      }
      if(e)return{err:pre+e};
      norm();snaps.push(JSON.stringify(S));ds.push(d);hl.push(h);
    }
    return{snaps,ds,hl,l:kif.slice()};
  }finally{({S,hist,hk,kif,sel,pend,msg}=sv)}
}
function showRp(){
  S=JSON.parse(rp.snaps[rp.k]);sel=-1;pend=null;
  const last=rp.snaps.length-1;
  msg=rp.k+'/'+last+'  '+(rp.k?rp.ds[rp.k-1]:'初期配置');
  if(rp.k==last&&S.over)msg+='  【終局:'+(S.over.why||'')+'】';
  $('rpSl').max=last;$('rpSl').value=rp.k;ui();
}
function setPlay(on){
  clearInterval(rpT);if(!rp)return;rp.play=on;
  if(on){const last=rp.snaps.length-1;if(rp.k>=last){rp.k=0;showRp()}
    rpT=setInterval(()=>{if(rp.k>=rp.snaps.length-1){setPlay(0);ui();return}rp.k++;showRp()},RT[spd])}
  ui();
}
function startRp(b){
  if(!rp)stash={S,hist,hk,kif,sel,pend,msg};
  gid++;busy=0;clearInterval(rpT);rp={...b,k:0,play:0};
  $('mRes').classList.add('hidden');showRp();
}
function exitRp(){
  if(!rp)return;clearInterval(rpT);
  ({S,hist,hk,kif,sel,pend,msg}=stash);stash=null;rp=null;busy=0;ui();
}
function rpGo(k){if(!rp)return;clearInterval(rpT);rp.play=0;rp.k=Math.max(0,Math.min(rp.snaps.length-1,k));showRp()}
function openKif(){
  $('kifTx').value=kifText(rp?rp.l:kif);$('kifMsg').textContent='';$('mKif').classList.remove('hidden');
}
$('bKif').onclick=openKif;
$('kifX').onclick=()=>$('mKif').classList.add('hidden');
$('kifCopy').onclick=async()=>{
  const t=$('kifTx');try{await navigator.clipboard.writeText(t.value);$('kifMsg').style.color='#16a34a';$('kifMsg').textContent='コピーしました'}
  catch(e){t.select();try{document.execCommand('copy');$('kifMsg').style.color='#16a34a';$('kifMsg').textContent='コピーしました'}catch(_){$('kifMsg').style.color='#dc2626';$('kifMsg').textContent='コピーできませんでした。手動で選択してください'}}
};
$('kifSave').onclick=()=>{
  const a=document.createElement('a'),u=URL.createObjectURL(new Blob([$('kifTx').value],{type:'text/plain'}));
  a.href=u;a.download='checkmeigo_kifu.txt';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1000);
};
$('kifFile').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{$('kifTx').value=r.result;$('kifMsg').style.color='#16a34a';$('kifMsg').textContent='ファイルを読み込みました。「読み込んで再生」を押してください'};r.readAsText(f);e.target.value=''};
$('kifLoad').onclick=()=>{
  $('kifMsg').style.color='#dc2626';
  const p=parseKif($('kifTx').value);if(p.err){$('kifMsg').textContent=p.err;return}
  const b=build(p.ops);if(b.err){$('kifMsg').textContent=b.err;return}
  $('mKif').classList.add('hidden');startRp(b);
};
$('resRp').onclick=()=>{const p=parseKif(kifText(kif));const b=p.err?p:build(p.ops);if(b.err){msg=b.err;ui();return}startRp(b)};
$('rpF').onclick=()=>rpGo(0);
$('rpB').onclick=()=>rpGo(rp.k-1);
$('rpN').onclick=()=>rpGo(rp.k+1);
$('rpL').onclick=()=>rpGo(rp.snaps.length-1);
$('rpP').onclick=()=>setPlay(rp.play?0:1);
$('rpX').onclick=exitRp;
$('rpSl').oninput=e=>rpGo(+e.target.value);
document.addEventListener('keydown',e=>{if(!rp)return;if(e.key=='ArrowLeft')rpGo(rp.k-1);else if(e.key=='ArrowRight')rpGo(rp.k+1)});
window.addEventListener('resize',draw);
function markModes(){document.querySelectorAll('#modes .opt').forEach(b=>b.classList.toggle('on',b.dataset.m==mode))}
$('modes').onclick=e=>{const m=e.target.dataset.m;if(m){mode=m;markModes()}};
markModes();
init();
</script>
