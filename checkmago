/* ===== AI (CCT評価:王手・駒取り・脅威 + 石の支援評価) ===== */
let IGN=0;
const PW={K:40,Q:30,R:24,B:16,N:16,P:8},KV=1e5,BUD=[900,600,250],HARD=2500,NS=90,C4=[[0,0],[0,1],[1,0],[1,1]];
const cl=s=>({n:s.n,st:s.st.slice(),pc:s.pc.map(q=>q&&{...q}),turn:s.turn,phase:s.phase,mv:s.mv&&{...s.mv},cap:{1:{...s.cap[1]},2:{...s.cap[2]}},over:s.over,ko:s.ko,rep:s.rep});
const Fs=(st,p,r,c)=>{let v=0;for(const[a,b]of C4){const s=st[(r+a)*9+c+b];if(s)v+=s==p?1:-1}return v};
// 1回の石で上がりうるフィールド値の上限(空き角に1つ+角にある敵石を取る分)
const ubs=(a,sq)=>{const r=sq>>3,c=sq&7;let e=0,d=0;for(const[x,y]of C4){const s=S.st[(r+x)*9+c+y];if(!s)e=1;else if(s!=a)d++}return e+d};
function calc(x,y,p,o){
  const i=y*9+x;if(o.st[i])return{err:1};
  const st=o.st.slice();st[i]=p;let cnt=0;
  for(const n of nb(i))if(st[n]==3-p){const g=grp(st,n);if(!libs(st,g)){g.forEach(k=>st[k]=0);cnt+=g.length}}
  if(!cnt&&!libs(st,grp(st,i)))return{err:1};
  if(st.join('')==o.ko)return{err:1};
  return{st,cnt};
}
// aが「駒の強さを無視した幾何学的」に取れる経路(1手/アクティビティ2の2手)を列挙
function routes(a){
  const R=[];IGN=1;
  for(let i=0;i<64;i++){const q=S.pc[i];if(!q||q.o!=a)continue;
    const f=F(a,i>>3,i&7),u=ubs(a,i);if(f+u<-2)continue;
    const add=(j,m)=>{if(!m.cap)return;const t=S.pc[m.to];R.push({i,j,t:m.to,k:t.t=='K',v:t.t=='K'?KV:VAL[t.t]})};
    const ms=gen(i);for(const m of ms)add(-1,m);
    if(f+u>=3)for(const m of ms){if(m.cap||m.castle!==undefined)continue;
      const t0=q.t,m0=q.m;S.pc[m.to]=q;S.pc[i]=null;q.m=1;if(t0=='P'&&(a==1&&m.to<8||a==2&&m.to>=56))q.t='Q';
      for(const z of gen(m.to))add(m.to,z);
      S.pc[i]=q;S.pc[m.to]=null;q.t=t0;q.m=m0}}
  IGN=0;return R;
}
function evR(R,st,a){let k=0,c=0;
  for(const x of R){const fi=Fs(st,a,x.i>>3,x.i&7);let atk;
    if(x.j<0){if(fi<=-3)continue;atk=fi}else{if(fi<3)continue;atk=Fs(st,a,x.j>>3,x.j&7)}
    if(atk>=(x.k?0:-Fs(st,a,x.t>>3,x.t&7))){if(x.k)k=1;else if(x.v>c)c=x.v}}
  return{k,c}}
// aが次の手番(石→駒)で何を取れるか。k:2=石なしでキング取り(王手) 1=石を打てばキング取り(見つけづらい王手) / cn,cs:石なし・石ありで取れる最大の駒価値
function thr(a){
  const R=routes(a),d=3-a,o={k:0,cn:0,cs:0};if(!R.length)return o;
  let b=evR(R,S.st,a);o.cn=o.cs=b.c;if(b.k){o.k=2;return o}
  const sq=new Set(),pts=new Set();R.forEach(x=>{sq.add(x.i);if(x.j>=0)sq.add(x.j);sq.add(x.t)});
  for(const s of sq)for(const[x,y]of C4){const n=((s>>3)+x)*9+(s&7)+y,z=S.st[n];
    if(!z)pts.add(n);else if(z==d){const l=new Set();grp(S.st,n).forEach(k=>nb(k).forEach(m=>{if(!S.st[m])l.add(m)}));if(l.size==1)pts.add([...l][0])}}
  for(const n of pts){const r=calc(n%9,(n/9)|0,a,S);if(r.err)continue;b=evR(R,r.st,a);if(b.k){o.k=1;break}if(b.c>o.cs)o.cs=b.c}
  return o}
// 局面の静的評価(pの視点)
function evPos(p){
  const e=3-p,cp=x=>Math.max(-3,Math.min(3,x));
  let v=(S.cap[p].p-S.cap[e].p)*100+(S.cap[p].s-S.cap[e].s)*40;
  for(let r=0;r<8;r++)for(let c=0;c<8;c++){const fp=F(p,r,c),q=S.pc[r*8+c];
    if(fp>=3)v+=6;else if(fp<=-3)v-=9;else if(fp==-2)v-=4;   // 自分の3マスを作る / 相手の2以上のマスを潰す
    if(!q)continue;const own=q.o==p,fo=own?fp:-fp,w=PW[q.t];
    v+=(own?1:-1)*cp(fo)*4;
    if(own){if(fo>=3)v+=w*.7;else if(fo==2)v+=w*.25}else{if(fo>=3)v-=w;else if(fo==2)v-=w*.6}}
  for(let i=0;i<64;i++){const k=S.pc[i];if(!k||k.t!='K')continue;const o=k.o==p?1:-1,r=i>>3,c=i&7,home=k.o==1?7:0;let sh=0,gd=0;
    for(let dr=-1;dr<=1;dr++)for(let dc=-1;dc<=1;dc++){if(!dr&&!dc)continue;const rr=r+dr,cc=c+dc;if(rr<0||rr>7||cc<0||cc>7)continue;
      sh+=Math.max(-2,Math.min(3,F(k.o,rr,cc)));const z=S.pc[rr*8+cc];if(z&&z.o==k.o&&z.t!='K')gd++}
    v+=o>0?sh*3+gd*7:-(sh*2+gd*3);
    if(o>0&&r==home&&(c==2||c==6)){const rk=S.pc[home*8+(c==2?3:5)];if(rk&&rk.o==p&&rk.t=='R')v+=38}}
  const sc=score();v+=(sc[p-1].t-sc[e-1].t)*8;
  for(let i=0;i<81;i++){const c=S.st[i];if(!c)continue;const m=c==p?4:-1;   // 自石の連結
    if(i%9<8&&S.st[i+1]==c)v+=m;if(i<72&&S.st[i+9]==c)v+=m}
  const seen=new Set();
  for(let i=0;i<81;i++){const c=S.st[i];if(!c||seen.has(i))continue;const g=grp(S.st,i),lb=new Set();g.forEach(k=>{seen.add(k);nb(k).forEach(n=>{if(!S.st[n])lb.add(n)})});
    const mine=c==p;if(lb.size==1)v+=(mine?-45:20)*g.length;else if(lb.size==2)v+=(mine?-5:3)*g.length}
  return v}
function seqsFor(){
  const T=S,o=T.turn,res=[];
  for(let i=0;i<64;i++){const q=T.pc[i];if(!q||q.o!=o)continue;if(T.mv&&T.mv.i!=i)continue;const a=T.mv?T.mv.left:actOf(i);if(!a)continue;
    for(const mo of gen(i)){
      if(a==2&&!mo.cap){S=cl(T);doMove(i,mo,1);let n=0;
        if(S.mv&&!S.over){const j=S.mv.i;for(const m2 of gen(j)){res.push([[i,mo],[j,m2]]);n++}}
        if(!n)res.push([[i,mo]]);S=T}
      else res.push([[i,mo]])}}
  return res}
function aiPlan(){
  const orig=S,p=S.turn,e=3-p,sv={sel,pend};let best={v:-1e12,x:-1,y:-1,sq:null};
  try{
    // 1) 石の候補(評価は自分の石打ちのタイミングで、石+駒をまとめて決める)
    const stones=[];
    if(orig.phase=='stone'){for(let y=0;y<9;y++)for(let x=0;x<9;x++){const r=calc(x,y,p,orig);if(r.err)continue;
      const t=cl(orig);t.st=r.st;t.cap[p].s+=r.cnt;t.phase='move';t.mv=null;t.ko=orig.st.join('');stones.push({x,y,t})}}
    else stones.push({x:-1,y:-1,t:cl(orig)});
    S=orig;const oc=new Set(),oa={};
    for(let i=0;i<64;i++){const q=S.pc[i];if(q&&q.o==p){oa[i]=actOf(i);for(const m of gen(i))if(m.cap)oc.add(i*64+m.to)}}
    // 2) 全(石,駒の手)を列挙し、駒取り・王手・石の支援で一次評価
    const cs=[];
    for(const st of stones){S=st.t;st.b=evPos(p);
      const ad=s=>st.x>=(s&7)&&st.x<=(s&7)+1&&st.y>=(s>>3)&&st.y<=(s>>3)+1;   // 交点が駒のマスの角か
      for(const sq of seqsFor()){
        const i0=sq[0][0],m0=sq[0][1],lm=sq[sq.length-1][1],to=lm.to,tg=S.pc[to],g=lm.cap?(tg.t=='K'?KV:VAL[tg.t]):0;let sp=0;
        if(st.x>=0){   // その駒の手をサポートする石
          if(ad(i0))sp+=8;if(ad(to))sp+=10+(g?6:0);
          if(sq.length>1){if(ad(m0.to))sp+=6;if(oa[i0]<2)sp+=30}
          if(g&&(sq.length>1?oa[i0]<2:!oc.has(i0*64+to)))sp+=40+Math.min(g,12)*10}   // 石のおかげで取れる手
        let ck=false;if(to!=i0){const q=S.pc[i0],c0=S.pc[to];S.pc[to]=q;S.pc[i0]=null;
          ck=gen(to).some(z=>z.cap&&S.pc[z.to].t=='K');S.pc[i0]=q;S.pc[to]=c0}
        cs.push({st,sq,g,sp,s1:st.b+g*100+sp+(ck?60:0)+Math.random()*3})}}
    cs.sort((a,b)=>b.s1-a.s1);
    // 3) 上位から順にCCT検証: 相手の(石→駒)でキングを取られる/駒を取られる手を避け、安全な駒取り・王手を優先
    const T0=performance.now();let safe=0;
    for(const c of cs){const el=performance.now()-T0;
      if(safe>=NS||(best.v>-5e5&&el>BUD[spd])||el>HARD)break;
      S=cl(c.st.t);for(const[i,m]of c.sq)doMove(i,m,1);
      if(S.over&&S.over.win==p){best={v:1e9,x:c.st.x,y:c.st.y,sq:c.sq};break}
      let v=evPos(p)+c.sp+Math.random()*3;const ta=thr(e);
      if(ta.k)v-=1e6;                                   // 自キングを取られる(王手を防げていない)
      else{safe++;const tm=thr(p),hang=ta.cs,ok=!hang;
        v-=hang*100+(hang?20:0);                         // 石を打たれて取られる駒
        if(ok){const ck=tm.k?(tm.k==2?120:70):0;v+=ck+(c.g||ck?150:0)}   // 安全な駒取り・王手
        v+=tm.cs*(ok?25:10)}                             // 脅威(次に取れる駒)
      if(v>best.v)best={v,x:c.st.x,y:c.st.y,sq:c.sq}}
    if(!best.sq)best={v:0,x:-1,y:-1,sq:null};
  }finally{S=orig;sel=sv.sel;pend=sv.pend;IGN=0}
  return best;
}
function aiTick(){
  if(rp||!isAI(S.turn)||paused||busy||S.over)return;
