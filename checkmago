<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>チェックメイゴ</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>♞</text></svg>">
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<style>
:root{--bg:#fff;--tx:#171717;--board:#808080;--line:#1c1c1c;--card:#fafafa;--bd:#e5e5e5;--fr:rgba(0,0,0,.34);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]):not([data-theme="go"]){--bg:#171717;--tx:#f5f5f5;--board:#808080;--line:#1c1c1c;--card:#262626;--bd:#3a3a3a;--fr:rgba(0,0,0,.34)}}
:root[data-theme="dark"]{--bg:#171717;--tx:#f5f5f5;--board:#808080;--line:#1c1c1c;--card:#262626;--bd:#3a3a3a;--fr:rgba(0,0,0,.34)}
:root[data-theme="go"]{--bg:#D9B382;--tx:#3e2211;--board:#AC8353;--line:#3b2610;--card:#ebd19d;--bd:#cbb07a;--fr:rgba(50,25,5,.4)}
body{touch-action:manipulation;font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Hiragino Sans",sans-serif;background:var(--bg);color:var(--tx)}
canvas{display:block;touch-action:manipulation}
.card{background:var(--card);border:1px solid var(--bd)}
.btn{background:var(--card);border:1px solid var(--bd)}
.opt{border:1px solid #d4d4d4;border-radius:8px;padding:8px 4px;font-weight:700;font-size:13px}
.opt.on{background:#171717;color:#fff}
.sp{border:1px solid var(--bd);background:var(--card);border-radius:12px;padding:8px 12px;font-size:12px;font-weight:700}
.sp.on{background:var(--tx);color:var(--bg)}
</style>
</head>
<body class="min-h-screen flex flex-col items-center p-3 sm:p-6 select-none">
<div class="w-full max-w-xl flex flex-col items-center gap-4">
  <header class="w-full flex items-center justify-between pt-1">
    <div class="w-[116px]"></div>
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-wider text-center">チェックメイゴ</h1>
    <div class="flex items-center gap-1">
      <button id="bKif" aria-label="棋譜" class="w-9 h-9 rounded-full opacity-70 hover:opacity-100 text-lg">📜</button>
      <button id="bRules" aria-label="ルールを見る" class="w-9 h-9 rounded-full opacity-50 hover:opacity-80 text-2xl font-semibold">ⓘ</button>
      <button id="bSet" aria-label="設定" class="w-9 h-9 rounded-full opacity-70 hover:opacity-100 text-xl">⚙</button>
    </div>
  </header>

  <div class="card w-full p-3.5 rounded-xl flex flex-col gap-2 text-sm sm:text-base">
    <div class="flex items-center justify-between font-medium">
      <div class="flex items-center gap-2"><span class="opacity-70">手番:</span><span id="turn" class="font-bold underline decoration-2 underline-offset-4"></span></div>
      <div id="phase" class="text-xs px-2.5 py-1 rounded-full font-semibold border opacity-80"></div>
    </div>
    <div class="pt-2 border-t border-current/10 text-xs sm:text-sm flex flex-col gap-1">
      <div><span class="opacity-70">アゲハマ:</span> <span id="cap"></span></div>
    </div>
  </div>

  <canvas id="cv" class="w-full aspect-square cursor-pointer max-w-[520px] rounded-lg"></canvas>
  <p id="msg" class="text-xs sm:text-sm font-medium min-h-[1.25rem] text-center"></p>
  <div id="resBox" class="card w-full p-3.5 rounded-xl text-sm leading-relaxed hidden"></div>

  <div id="ctlGrid" class="w-full grid grid-cols-3 gap-2">
    <button id="bUndo" class="btn py-2.5 text-xs sm:text-sm font-bold rounded-xl active:scale-95">一手戻る</button>
    <button id="bPass" class="btn py-2.5 text-xs sm:text-sm font-bold rounded-xl active:scale-95">パス</button>
    
    <button id="bRes" class="py-2.5 text-xs sm:text-sm font-bold border border-red-500/50 text-red-600 rounded-xl active:scale-95">投了</button>
  </div>
  <div id="rpPanel" class="w-full flex flex-col gap-2 hidden">
    <input id="rpSl" type="range" min="0" max="0" value="0" class="w-full">
    <div class="grid grid-cols-5 gap-2">
      <button id="rpF" class="btn py-2.5 text-sm font-bold rounded-xl active:scale-95" aria-label="最初へ">⏮</button>
      <button id="rpB" class="btn py-2.5 text-sm font-bold rounded-xl active:scale-95" aria-label="一手戻る">◀</button>
      <button id="rpP" class="btn py-2.5 text-xs font-bold rounded-xl active:scale-95">▶ 再生</button>
      <button id="rpN" class="btn py-2.5 text-sm font-bold rounded-xl active:scale-95" aria-label="一手進む">▶</button>
      <button id="rpL" class="btn py-2.5 text-sm font-bold rounded-xl active:scale-95" aria-label="最後へ">⏭</button>
    </div>
    <div class="flex items-center justify-between gap-2">
      <div id="rspds" class="flex items-center gap-1"><span class="text-xs opacity-60 pr-1">速度</span><button class="sp" data-s="0">遅</button><button class="sp" data-s="1">中</button><button class="sp" data-s="2">速</button></div>
      <button id="rpX" class="btn px-4 py-2.5 text-xs sm:text-sm font-bold rounded-xl active:scale-95">対局に戻る</button>
    </div>
  </div>
  <div id="aiCtl" class="w-full flex items-center gap-2 hidden">
    <button id="bPause" class="btn flex-1 py-2.5 text-xs sm:text-sm font-bold rounded-xl active:scale-95">⏸ 一時停止</button>
    <div id="spds" class="flex items-center gap-1"><span class="text-xs opacity-60 pr-1">速度</span><button class="sp" data-s="0">遅</button><button class="sp" data-s="1">中</button><button class="sp" data-s="2">速</button></div>
  </div>
  <p class="text-xs opacity-60 text-center leading-relaxed">石:交点を1タップでプレビュー、同じ交点をもう1タップで確定 / 駒:駒を選んで行き先をタップ<br>マスの数字はフィールド値(白文字・明るいマス=白側、黒文字・暗いマス=黒側)</p>
</div>



<div id="mSet" class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden">
  <div class="bg-white text-neutral-900 p-5 max-w-md w-full rounded-2xl shadow-2xl flex flex-col gap-4">
    <div class="flex items-center justify-between border-b pb-3"><h2 class="text-xl font-bold">ゲーム設定</h2><button id="setX" class="text-neutral-400 text-xl font-bold px-2">✕</button></div>
    <label class="text-xs font-bold tracking-wider text-neutral-500">対戦相手(次のニューゲームから)</label>
    <div class="grid grid-cols-2 gap-2" id="modes">
      <button data-m="ai2" class="opt">AI(黒)と対戦</button><button data-m="ai1" class="opt">AI(白)と対戦</button><button data-m="pvp" class="opt">2人で対戦</button><button data-m="aiai" class="opt">AI同士を観戦</button>
    </div>
    <label class="text-xs font-bold tracking-wider text-neutral-500">カラーテーマ</label>
    <div class="grid grid-cols-3 gap-2" id="themes">
      <button data-t="light" class="opt">明るい</button><button data-t="dark" class="opt">ダーク</button><button data-t="go" class="opt">木目風</button>
    </div>
    <button id="bNew" class="w-full py-3 bg-neutral-900 text-white font-bold text-sm rounded-xl">ニューゲームスタート</button>
  </div>
</div>

<div id="mKif" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50 hidden">
  <div class="bg-white text-neutral-900 p-5 max-w-md w-full rounded-2xl shadow-2xl flex flex-col gap-3 max-h-[88vh] overflow-y-auto text-sm">
    <div class="flex items-center justify-between border-b pb-3"><h2 class="text-xl font-extrabold">棋譜</h2><button id="kifX" class="text-neutral-400 text-xl font-bold px-2">✕</button></div>
    <p class="text-xs text-neutral-500 leading-relaxed">下の欄には現在の棋譜が入っています。別の棋譜を貼り付けるかファイルを選んで「読み込んで再生」を押すと再生できます。<br>W/B=白/黒(手番の先頭に付く) / 石: 2桁の数字(列行・左上が11)例 B77 / 駒: 移動元-移動先(左下がa1)例 We2-e4 / xは駒取り・末尾の英字は駒種(ポーンは無し) 例 g1-f3N / Wpass=石パス / Wresign=白投了</p>
    <textarea id="kifTx" class="w-full h-36 border border-neutral-300 rounded-lg p-2 font-mono text-xs text-neutral-900 bg-white" spellcheck="false"></textarea>
    <p id="kifMsg" class="text-xs font-medium min-h-[1rem] text-red-600"></p>
    <div class="grid grid-cols-3 gap-2">
      <button id="kifCopy" class="py-2.5 bg-neutral-100 text-neutral-800 text-xs font-bold rounded-xl">コピー</button>
      <button id="kifSave" class="py-2.5 bg-neutral-100 text-neutral-800 text-xs font-bold rounded-xl">保存(.txt)</button>
      <label class="py-2.5 bg-neutral-100 text-neutral-800 text-xs font-bold rounded-xl text-center cursor-pointer">ファイル選択<input id="kifFile" type="file" accept=".txt,text/plain" class="hidden"></label>
    </div>
    <button id="kifLoad" class="w-full py-3 bg-neutral-900 text-white font-bold text-sm rounded-xl">読み込んで再生</button>
  </div>
</div>

<div id="mRules" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50 hidden">
  <div class="bg-white text-neutral-900 p-5 max-w-md w-full rounded-2xl shadow-2xl flex flex-col gap-3 max-h-[88vh] overflow-y-auto text-sm leading-relaxed">
    <div class="flex items-center justify-between border-b pb-3"><h2 class="text-xl font-extrabold">チェックメイゴ ルール</h2><button id="rulX" class="text-neutral-400 text-xl font-bold px-2">✕</button></div>
    <p><b>1. 盤</b> 9×9の格子点(目)に碁石、8×8のマスにチェスの駒を置きます。白(下側)が先行です。</p>
    <p><b>2. 1ターン</b> 碁石を置く→駒をムーブ、で1セット。先行1ターン目のみムーブだけです。</p>
    <p><b>3. フィールド値</b> 各マスの値＝四隅の目の自石数−敵石数(自分視点)。石を置くと周囲4マスが変化します。</p>
    <p><b>4. 攻撃力・防御力</b> 駒の攻撃力＝今いるマスの値、防御力＝取られるマスの値。攻撃力が防御力以上のときだけ取れます。キングの防御力は常に0。</p>
    <p><b>5. アクティビティ</b> 石を置いた後、全駒に基本1。駒のいるマスの値が3以上なら2、−3以下なら0。その回数だけ同じ駒を動かせます(取ったら終了)。2手目の攻撃力は経由マスの値です。</p>
    <p><b>6. 駒</b> ポーン1・ビショップ/ナイト3・ルーク5・クイーン9。キャスリングはキングのムーブです。ポーンは最奥でクイーンに昇格。</p>
    <p><b>7. 勝敗</b> キングを取れば勝ち(キングは価値∞)。千日手(同一盤面3回・石のパス含む)とステイルメイト(駒の合法手がない)は引き分けとし、囲碁の計数(地＋取った石＋取った駒の価値)で決着します。</p>
    <button id="rulOk" class="w-full py-2.5 bg-neutral-900 text-white font-bold rounded-xl">閉じる</button>
  </div>
</div>

<div id="mRes" class="fixed inset-0 bg-black/60 flex items-center justify-center p-4 z-50 hidden">
  <div class="bg-white text-neutral-900 p-6 max-w-sm w-full text-center flex flex-col gap-4 rounded-2xl shadow-2xl">
    <h2 id="resT" class="text-2xl font-extrabold">対局終了</h2>
    <div id="resD" class="text-sm text-neutral-700 py-3 border-y border-neutral-200 font-medium leading-relaxed"></div>
    <button id="resView" class="w-full py-2.5 bg-neutral-100 text-neutral-800 text-sm font-bold rounded-xl">盤面を確認する</button>
    <button id="resRp" class="w-full py-2.5 bg-neutral-100 text-neutral-800 text-sm font-bold rounded-xl">棋譜を再生</button>
    <button id="resAgain" class="w-full py-2.5 bg-neutral-900 text-white text-sm font-bold rounded-xl">もう一度遊ぶ</button>
  </div>
</div>

<script>
const $=id=>document.getElementById(id);
const NM=['','白','黒'],VAL={P:1,N:3,B:3,R:5,Q:9,K:0},GL={K:'♚',Q:'♛',R:'♜',B:'♝',N:'♞',P:'♟'};
const cv=$('cv'),cx=cv.getContext('2d');
let S,hist=[],sel=-1,pend=null,msg='',aiOn=true,aiSide=2,busy=0,gid=0,mode='ai2',paused=0,aiBoth=0,spd=1,kif=[],hk=[],rp=null,stash=null,rpT=0;
const RT=[1500,700,200],FL='abcdefghi';
const CN=['','W','B'],sqn=i=>FL[i&7]+(8-(i>>3));
const TH=[900,300,60],MV=[1000,400,60],MAXT=300;
const isAI=t=>aiOn&&(aiBoth||t==aiSide);

function newS(){
  const bk='RNBQKBNR',pc=Array(64).fill(null);
  for(let c=0;c<8;c++){pc[c]={t:bk[c],o:2,m:0};pc[8+c]={t:'P',o:2,m:0};pc[48+c]={t:'P',o:1,m:0};pc[56+c]={t:bk[c],o:1,m:0}}
  return{n:0,st:Array(81).fill(0),pc,turn:1,phase:'move',mv:null,cap:{1:{s:0,p:0},2:{s:0,p:0}},over:null,ko:'',rep:{}};
}
function init(){
  clearInterval(rpT);rp=null;stash=null;kif=[];hk=[];
  S=newS();hist=[];sel=-1;pend=null;gid++;busy=0;aiOn=mode!='pvp';aiBoth=mode=='aiai';paused=0;aiSide=mode=='ai1'?1:2;msg=aiBoth?'AI同士の対戦を開始します':'先行1ターン目は駒を動かすだけです';ui();
}
const push=()=>{hist.push(JSON.stringify(S));hk.push(kif.length)};
const passStone=()=>{push();S.phase='move';S.ko='';pend=null;msg='';rec();kif.push(CN[S.turn]+'pass')};
function F(p,r,c){let v=0;for(const[a,b]of[[0,0],[0,1],[1,0],[1,1]]){const s=S.st[(r+a)*9+c+b];if(s)v+=s==p?1:-1}return v}
function actOf(i){const q=S.pc[i],f=F(q.o,i>>3,i&7);return f>=3?2:f<=-3?0:1}
function nb(i){const x=i%9,y=(i/9)|0,o=[];if(x>0)o.push(i-1);if(x<8)o.push(i+1);if(y>0)o.push(i-9);if(y<8)o.push(i+9);return o}
function grp(st,i){const col=st[i],seen=new Set([i]),q=[i];while(q.length){const k=q.pop();for(const n of nb(k))if(st[n]==col&&!seen.has(n)){seen.add(n);q.push(n)}}return[...seen]}
const libs=(st,g)=>g.some(k=>nb(k).some(n=>!st[n]));

function place(x,y){
  const p=S.turn,i=y*9+x;if(S.st[i])return'そこには打てません';
  const st=S.st.slice();st[i]=p;let cnt=0;
  for(const n of nb(i))if(st[n]==3-p){const g=grp(st,n);if(!libs(st,g)){g.forEach(k=>st[k]=0);cnt+=g.length}}
  if(!cnt&&!libs(st,grp(st,i)))return'自殺手は打てません';
  if(st.join('')==S.ko)return'コウ:直前の局面に戻る手は打てません';
  push();S.ko=S.st.join('');S.st=st;S.cap[p].s+=cnt;S.phase='move';S.mv=null;sel=-1;pend=null;rec();kif.push(CN[p]+(x+1)+(y+1));return'';
}

function gen(i){
  const q=S.pc[i],r=i>>3,c=i&7,o=q.o,out=[],atk=F(o,r,c);
  const tr=(rr,cc,mode)=>{
    if(rr<0||rr>7||cc<0||cc>7)return 0;const j=rr*8+cc,t=S.pc[j];
    if(!t){if(mode!=2)out.push({to:j});return 1}
    if(t.o==o)return 0;
    if(mode!=1){const def=t.t=='K'?0:F(t.o,rr,cc);if(IGN||atk>=def)out.push({to:j,cap:1})}
    return 0};
  const slide=ds=>{for(const[a,b]of ds){let rr=r+a,cc=c+b;while(tr(rr,cc,0)){rr+=a;cc+=b}}};
  const step=ds=>{for(const[a,b]of ds)tr(r+a,c+b,0)};
  const D=[[1,0],[-1,0],[0,1],[0,-1]],G=[[1,1],[1,-1],[-1,1],[-1,-1]];
  if(q.t=='P'){const d=o==1?-1:1;tr(r+d,c,1);
    if((o==1&&r==6||o==2&&r==1)&&!S.pc[(r+d)*8+c])tr(r+2*d,c,1);
    tr(r+d,c-1,2);tr(r+d,c+1,2)}
  else if(q.t=='N')step([[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]]);
  else if(q.t=='B')slide(G);else if(q.t=='R')slide(D);else if(q.t=='Q')slide(D.concat(G));
  else{step(D.concat(G));
    if(!q.m&&c==4&&r==(o==1?7:0))for(const rc of[0,7]){
      const rk=S.pc[r*8+rc];if(!(rk&&rk.t=='R'&&rk.o==o&&!rk.m))continue;
      let ok=1;for(let x=Math.min(rc,c)+1;x<Math.max(rc,c);x++)if(S.pc[r*8+x])ok=0;
      if(ok)out.push({to:r*8+(rc==0?2:6),castle:rc})}}
  return out;
}

function rec(){
  const k=S.st.join('')+S.pc.map(q=>q?q.t+q.o:'.').join('')+S.turn+S.phase+(S.mv?S.mv.i+'_'+S.mv.left:'');
  S.rep[k]=(S.rep[k]||0)+1;
  if(S.rep[k]>=3&&!S.over)S.over={draw:1,why:'千日手(同一盤面が3回)'};
}
function endTurn(){S.n=(S.n||0)+1;if(S.n>=MAXT&&!S.over)S.over={draw:1,why:'手数上限('+MAXT+'ターン)'};S.turn=3-S.turn;S.phase='stone';S.mv=null;sel=-1;pend=null}
function doMove(i,m,sim){
  if(!sim){push();const q0=S.pc[i];kif.push((kif.length?'':CN[q0.o])+sqn(i)+(S.pc[m.to]?'x':'-')+sqn(m.to)+(q0.t=='P'?'':q0.t)+(q0.t=='P'&&(q0.o==1&&m.to<8||q0.o==2&&m.to>=56)?'=Q':''))}const q=S.pc[i],o=q.o,t=S.pc[m.to],left0=S.mv?S.mv.left:actOf(i);let cap=0;
  if(t){cap=1;S.cap[o].p+=VAL[t.t];if(t.t=='K')S.over={win:o,why:'キングを取りました'}}
  S.pc[m.to]=q;S.pc[i]=null;q.m=1;
  if(m.castle!==undefined){const r=i>>3,nc=m.castle==0?3:5;S.pc[r*8+nc]=S.pc[r*8+m.castle];S.pc[r*8+nc].m=1;S.pc[r*8+m.castle]=null}
  if(q.t=='P'&&(o==1&&m.to<8||o==2&&m.to>=56))q.t='Q';
  S.mv={i:m.to,left:left0-1};
  if(cap||S.mv.left<=0||S.over)endTurn();else sel=m.to;
  if(!sim){msg='';rec()}
}

function score(){
  const t={1:0,2:0},seen=new Set();
  for(let i=0;i<81;i++){if(S.st[i]||seen.has(i))continue;
    let n=0;const b=new Set(),q=[i];seen.add(i);
    while(q.length){const k=q.pop();n++;for(const x of nb(k)){if(S.st[x])b.add(S.st[x]);else if(!seen.has(x)){seen.add(x);q.push(x)}}}
    if(b.size==1)t[[...b][0]]+=n}
  return[1,2].map(p=>({t:t[p],s:S.cap[p].s,p:S.cap[p].p,sum:t[p]+S.cap[p].s+S.cap[p].p}));
}

function draw(){
  const w=cv.clientWidth,d=window.devicePixelRatio||1;if(!w)return;
  if(cv.width!=Math.round(w*d)){cv.width=Math.round(w*d);cv.height=Math.round(w*d)}
  cx.setTransform(d,0,0,d,0,0);
  const s=w/9.6,m=.8*s,css=getComputedStyle(document.documentElement),g=n=>css.getPropertyValue(n).trim();
  cx.fillStyle=g('--board');cx.fillRect(0,0,w,w);
  cx.textAlign='center';cx.textBaseline='middle';
  for(let r=0;r<8;r++)for(let c=0;c<8;c++){
    const x=m+c*s,y=m+r*s,f=F(1,r,c),a=Math.min(Math.abs(f),4)*.13;
    if(f){cx.fillStyle=f>0?`rgba(255,255,255,${a})`:`rgba(0,0,0,${a})`;cx.fillRect(x,y,s,s)}
    if((r+c)%2){cx.strokeStyle=g('--fr');cx.lineWidth=1.5;const k=s*.09;cx.strokeRect(x+k,y+k,s-2*k,s-2*k)}
    if(f){const n=String(Math.abs(f));
      cx.font=`bold ${s*.2}px system-ui`;cx.lineWidth=2.5;cx.strokeStyle=f>0?'#222':'#ddd';cx.fillStyle=f>0?'#fff':'#111';cx.strokeText(n,x+s*.5,y+s*.2);cx.fillText(n,x+s*.5,y+s*.2)}}
